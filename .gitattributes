# GitHub Linguist Language Configuration
# Ensure balanced polyglot representation across Python, Rust, Go, and TypeScript

# Vendor canvas engine boilerplate, inspiration fixtures, and service clients
src/canvas/** linguist-vendored
src/lib/inspiration/** linguist-vendored
src/services/** linguist-vendored

# Explicit language detection
*.py linguist-detectable
*.py linguist-language=Python
*.rs linguist-detectable
*.rs linguist-language=Rust
*.go linguist-detectable
*.go linguist-language=Go
*.ts linguist-detectable
*.tsx linguist-detectable

# Force repository directory mappings
services/ai_engine/** linguist-detectable
services/ai_engine/** linguist-language=Python
crates/color_core/** linguist-detectable
crates/color_core/** linguist-language=Rust
services/collab_server/** linguist-detectable
services/collab_server/** linguist-language=Go

# Line endings
* text=auto eol=lf
